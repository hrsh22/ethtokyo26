# API origin seen by local clients. The web app proxies /api to this address.
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_DEMO_SPACE_ADDRESS=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Activity history (event logs). publicnode returns no logs for older Sepolia blocks.
SEPOLIA_HISTORY_RPC_URL=https://sepolia.gateway.tenderly.co
DATABASE_FILE=../../.data/accord.sqlite
# Optional private archive for the published demo, independent of app resets.
DEMO_EVIDENCE_DATABASE_FILE=
WEB_ORIGIN=http://localhost:3000

# Configure these locally when testing live partner integrations.
WORLD_RP_ID=rp_93bf1ee875f88ada
WORLD_RP_SIGNING_KEY=
WORLD_APP_ID=app_0193591d58a09cf60e0dd4f6fe4303e0
WORLD_ENVIRONMENT=production
INTERCEPTA_API_KEY=
PERMIT_SIGNER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
DEMO_HUMAN_PRIVATE_KEY=
DEMO_AGENT_PRIVATE_KEY=
# Optional public wallet address for the 5 tUSDC live human claim demo.
DEMO_BENEFICIARY_ADDRESS=
SPACE_FACTORY_ADDRESS=0x3ccbb42840e290e38f4f10040e08140179dfa0a9
FORWARDER_ADDRESS=0x947f24d2749f00be27062cec447457cac3c7a6e0
# Separate Sepolia wallet that pays users' network fees. Never expose this key to Vercel.
SPONSOR_PRIVATE_KEY=
ENS_ADAPTER_ADDRESS=0xdb4240a0da5df5831857ac5482265326d98fdfa0
DEMO_TOKEN_ADDRESS=0x06729abbe1b9683ea3d5addd151c15c93be2a0a4
# ENSv2 Beta ETHRegistry listed in ENS's current Sepolia app deployment page.
ENSV2_REGISTRY_ADDRESS=0x657ea849311d3d5823348dded7c2aaafb3ede09e
# Sepolia ENSv2 Universal Resolver proxy: human payment-address records.
ENSV2_UNIVERSAL_RESOLVER_ADDRESS=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe

# Demo report seller receives tUSDC; no seller private key is needed by the API.
RESEARCH_SELLER_ADDRESS=
RESEARCH_PRICE_BASE_UNITS=1000000
# Optional GitHub API token for higher public-repository research rate limits.
# Backend only; never use NEXT_PUBLIC_ for this token.
GITHUB_RESEARCH_TOKEN=

# ENSv2 namespace and fresh owner approvals (backend only).
ENS_NAMESPACE_NAME=accordspaces26.eth
ENS_NAMESPACE_REGISTRY=
# Optional dedicated key; defaults to DEPLOYER_PRIVATE_KEY.
ENS_REGISTRAR_PRIVATE_KEY=
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_REDIRECT_URI=https://accord-api.hrsh.dev/v1/approvals/world/callback
WORLD_AGENTS_TOKEN_ENDPOINT_AUTH_METHOD=private_key_jwt
WORLD_AGENTS_PRIVATE_KEY_PATH=/home/accord-api/.config/accord/world-agents-private.pem
WORLD_AGENTS_KEY_ID=
